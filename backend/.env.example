# MyTrolley backend environment template.
# Copy this file to backend/.env and replace every placeholder.
# backend/.env is gitignored and must never be committed.
# Values may also be supplied as real process environment variables, which
# take precedence over this file.

# --- Django -----------------------------------------------------------------
# Required: at least 50 characters with high variation. Generate a unique
# value, for example: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-unique-50-plus-character-secret

# Comma-separated exact hosts. Never use "*" in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Development settings are the manage.py default. Production must set
# config.settings.production explicitly (for example via DJANGO_SETTINGS_MODULE).
# DJANGO_SETTINGS_MODULE=config.settings.development

# --- PostgreSQL -------------------------------------------------------------
DB_NAME=mytrolley
DB_USER=mytrolley_app
DB_PASSWORD=replace-with-the-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5
DB_CONN_MAX_AGE=0

# Name used only by pytest/Django's test database creation.
TEST_DB_NAME=test_mytrolley

# Production requires require/verify-ca/verify-full. For verify-ca and
# verify-full, also set an absolute or backend-relative CA path.
# DB_SSLROOTCERT=replace-with-path-to-provider-ca.pem

# --- CSRF and proxy assumptions --------------------------------------------
# Exact scheme://host[:port] origins only. No wildcards, paths or credentials.
# Add the browser origin when it differs from the API origin behind a proxy.
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Enable only behind a controlled reverse proxy that overwrites
# X-Forwarded-Proto/X-Forwarded-For. Leave false for direct connections.
TRUST_PROXY_HEADERS=false

# --- Admin and API documentation -------------------------------------------
ADMIN_URL=admin/
# Optional comma-separated exact IPs/CIDRs, for example 10.0.0.0/8,203.0.113.10
ADMIN_ALLOWED_IPS=
ENABLE_API_DOCS=true

# --- Request limits ---------------------------------------------------------
MAX_JSON_BODY_BYTES=65536

# --- Login abuse protection (database-backed) ------------------------------
LOGIN_THROTTLE_USERNAME_LIMIT=10
LOGIN_THROTTLE_IP_LIMIT=20
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_COOLDOWN_SECONDS=900

# --- Readiness probe --------------------------------------------------------
HEALTH_DB_STATEMENT_TIMEOUT_MS=2000

# --- Production-only HSTS values (validated by config.settings.production) ---
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false
